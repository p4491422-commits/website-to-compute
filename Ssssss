<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Lost & Found Portal</title>
<script src="https://www.gstatic.com/firebasejs/9.23.0/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/9.23.0/firebase-auth-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/9.23.0/firebase-database-compat.js"></script>
<style>
  body { font-family: Arial; margin:0; padding:0; background:#f5f5f5; }
  .container { max-width:800px; margin:auto; padding:20px; }
  h2, h3 { text-align:center; color:#d32f2f; }
  input, textarea, button, select { width:100%; padding:10px; margin:5px 0; border-radius:5px; border:1px solid #ccc; }
  button { background:#d32f2f; color:white; border:none; cursor:pointer; }
  button:hover { background:#b71c1c; }
  .hidden { display:none; }
  .tab { display:none; padding:10px; background:white; border-radius:10px; box-shadow:0 0 5px #ccc; margin-top:10px; }
  .tab.active { display:block; }
  .tab-buttons button { width:24%; display:inline-block; margin:0; border-radius:0; }
  table { width:100%; border-collapse: collapse; }
  table, th, td { border:1px solid #ccc; }
  th, td { padding:8px; text-align:left; }
  .messages { max-height:200px; overflow-y:auto; background:#eee; padding:10px; border-radius:5px; margin-bottom:10px; }
</style>
</head>
<body>

<div class="container" id="auth-container">
  <h2>Lost & Found Portal</h2>

  <div id="register-form">
    <h3>Register</h3>
    <input type="text" id="reg-username" placeholder="Username">
    <input type="email" id="reg-email" placeholder="Email">
    <input type="password" id="reg-password" placeholder="Password">
    <button onclick="registerUser()">Register</button>
    <p>Already have an account? <span style="color:blue;cursor:pointer" onclick="showLogin()">Sign In</span></p>
  </div>

  <div id="login-form" class="hidden">
    <h3>Sign In</h3>
    <input type="email" id="login-email" placeholder="Email">
    <input type="password" id="login-password" placeholder="Password">
    <button onclick="loginUser()">Login</button>
    <p>New user? <span style="color:blue;cursor:pointer" onclick="showRegister()">Register</span></p>
  </div>
</div>

<div class="container hidden" id="main-container">
  <h2>Welcome <span id="user-name"></span></h2>
  <button style="background:#555;margin-bottom:10px;" onclick="logout()">Logout</button>

  <div class="tab-buttons">
    <button onclick="showTab('lost-items-tab')">Lost Items</button>
    <button onclick="showTab('found-items-tab')">Found Items</button>
    <button onclick="showTab('lost-persons-tab')">Lost Persons</button>
    <button onclick="showTab('found-persons-tab')">Found Persons</button>
    <button onclick="showTab('messages-tab')">Messages</button>
  </div>

  <!-- Lost Items -->
  <div class="tab" id="lost-items-tab">
    <h3>Lost Items</h3>
    <input type="text" id="lost-item-name" placeholder="Item Name">
    <textarea id="lost-item-desc" placeholder="Description"></textarea>
    <button onclick="addLostItem()">Add Lost Item</button>
    <table>
      <thead><tr><th>Item</th><th>Description</th></tr></thead>
      <tbody id="lost-items-table"></tbody>
    </table>
  </div>

  <!-- Found Items -->
  <div class="tab" id="found-items-tab">
    <h3>Found Items</h3>
    <input type="text" id="found-item-name" placeholder="Item Name">
    <textarea id="found-item-desc" placeholder="Description"></textarea>
    <button onclick="addFoundItem()">Add Found Item</button>
    <table>
      <thead><tr><th>Item</th><th>Description</th></tr></thead>
      <tbody id="found-items-table"></tbody>
    </table>
  </div>

  <!-- Lost Persons -->
  <div class="tab" id="lost-persons-tab">
    <h3>Lost Persons</h3>
    <input type="text" id="lost-person-name" placeholder="Person Name">
    <textarea id="lost-person-desc" placeholder="Details"></textarea>
    <button onclick="addLostPerson()">Add Lost Person</button>
    <table>
      <thead><tr><th>Name</th><th>Details</th></tr></thead>
      <tbody id="lost-persons-table"></tbody>
    </table>
  </div>

  <!-- Found Persons -->
  <div class="tab" id="found-persons-tab">
    <h3>Found Persons</h3>
    <input type="text" id="found-person-name" placeholder="Person Name">
    <textarea id="found-person-desc" placeholder="Details"></textarea>
    <button onclick="addFoundPerson()">Add Found Person</button>
    <table>
      <thead><tr><th>Name</th><th>Details</th></tr></thead>
      <tbody id="found-persons-table"></tbody>
    </table>
  </div>

  <!-- Messages -->
  <div class="tab" id="messages-tab">
    <h3>Messages</h3>
    <div class="messages" id="messages-box"></div>
    <input type="text" id="message-input" placeholder="Type your message">
    <button onclick="sendMessage()">Send to All</button>
  </div>
</div>

<script>
  // --------------- Firebase Config ---------------
  const firebaseConfig = {
    apiKey: "YOUR_API_KEY",
    authDomain: "YOUR_PROJECT_ID.firebaseapp.com",
    databaseURL: "https://YOUR_PROJECT_ID.firebaseio.com",
    projectId: "YOUR_PROJECT_ID",
    storageBucket: "YOUR_PROJECT_ID.appspot.com",
    messagingSenderId: "YOUR_SENDER_ID",
    appId: "YOUR_APP_ID"
  };
  firebase.initializeApp(firebaseConfig);
  const auth = firebase.auth();
  const db = firebase.database();

  // --------------- Auth Functions ---------------
  function showLogin(){ document.getElementById('register-form').classList.add('hidden'); document.getElementById('login-form').classList.remove('hidden'); }
  function showRegister(){ document.getElementById('login-form').classList.add('hidden'); document.getElementById('register-form').classList.remove('hidden'); }

  function registerUser(){
    const username=document.getElementById('reg-username').value;
    const email=document.getElementById('reg-email').value;
    const password=document.getElementById('reg-password').value;
    if(username && email && password){
      auth.createUserWithEmailAndPassword(email,password)
      .then(userCred=>{
        db.ref('users/'+userCred.user.uid).set({username,email});
        alert("Registered successfully!");
        showLogin();
      })
      .catch(e=>alert(e.message));
    } else alert('Fill all fields');
  }

  function loginUser(){
    const email=document.getElementById('login-email').value;
    const password=document.getElementById('login-password').value;
    if(email && password){
      auth.signInWithEmailAndPassword(email,password)
      .then(userCred=>{
        document.getElementById('auth-container').classList.add('hidden');
        document.getElementById('main-container').classList.remove('hidden');
        db.ref('users/'+userCred.user.uid).once('value').then(snap=>{
          document.getElementById('user-name').innerText = snap.val().username;
        });
        loadData();
        showTab('lost-items-tab');
      })
      .catch(e=>alert(e.message));
    } else alert('Fill all fields');
  }

  function logout(){ auth.signOut().then(()=>location.reload()); }

  // --------------- Tabs ---------------
  function showTab(tabId){
    document.querySelectorAll('.tab').forEach(t=>t.classList.remove('active'));
    document.getElementById(tabId).classList.add('active');
  }

  // --------------- Add Data ---------------
  function addLostItem(){ const name=document.getElementById('lost-item-name').value; const desc=document.getElementById('lost-item-desc').value; if(name){ db.ref('lost-items').push({name,desc}); document.getElementById('lost-item-name').value=''; document.getElementById('lost-item-desc').value=''; } }
  function addFoundItem(){ const name=document.getElementById('found-item-name').value; const desc=document.getElementById('found-item-desc').value; if(name){ db.ref('found-items').push({name,desc}); document.getElementById('found-item-name').value=''; document.getElementById('found-item-desc').value=''; } }
  function addLostPerson(){ const name=document.getElementById('lost-person-name').value; const desc=document.getElementById('lost-person-desc').value; if(name){ db.ref('lost-persons').push({name,desc}); document.getElementById('lost-person-name').value=''; document.getElementById('lost-person-desc').value=''; } }
  function addFoundPerson(){ const name=document.getElementById('found-person-name').value; const desc=document.getElementById('found-person-desc').value; if(name){ db.ref('found-persons').push({name,desc}); document.getElementById('found-person-name').value=''; document.getElementById('found-person-desc').value=''; } }

  // --------------- Load Data ---------------
  function loadData(){
    db.ref('lost-items').on('value', snap=>{
      let html=''; snap.forEach(c=>{ const d=c.val(); html+=`<tr><td>${d.name}</td><td>${d.desc}</td></tr>`; }); document.getElementById('lost-items-table').innerHTML=html;
    });
    db.ref('found-items').on('value', snap=>{
      let html=''; snap.forEach(c=>{ const d=c.val(); html+=`<tr><td>${d.name}</td><td>${d.desc}</td></tr>`; }); document.getElementById('found-items-table').innerHTML=html;
    });
    db.ref('lost-persons').on('value', snap=>{
      let html=''; snap.forEach(c=>{ const d=c.val(); html+=`<tr><td>${d.name}</td><td>${d.desc}</td></tr>`; }); document.getElementById('lost-persons-table').innerHTML=html;
    });
    db.ref('found-persons').on('value', snap=>{
      let html=''; snap.forEach(c=>{ const d=c.val(); html+=`<tr><td>${d.name}</td><td>${d.desc}</td></tr>`; }); document.getElementById('found-persons-table').innerHTML=html;
    });
    db.ref('messages').on('value', snap=>{
      let html=''; snap.forEach(c=>{ const d=c.val(); html+=`<p><b>${d.user}:</b> ${d.text}</p>`; }); document.getElementById('messages-box').innerHTML=html;
    });
  }

  // --------------- Messaging ---------------
  function sendMessage(){
    const text=document.getElementById('message-input').value;
    if(text){
      db.ref('messages').push({user:document.getElementById('user-name').innerText,text});
      document.getElementById('message-input').value='';
    }
  }
</script>

</body>
</html>
